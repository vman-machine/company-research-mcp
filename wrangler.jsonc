{
  // Cloudflare Workers deployment. Free plan is enough: Workers + a KV namespace.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company-research-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    // Build the two MCP App views (single-file HTML) before bundling the worker.
    "command": "npm run build:ui"
  },
  "kv_namespaces": [
    {
      // Profiles and saved reports. The "Deploy to Cloudflare" flow replaces this placeholder
      // id with a freshly provisioned namespace. For a manual deploy run
      // `npx wrangler kv namespace create RESEARCH_KV` and paste the real id here.
      "binding": "RESEARCH_KV",
      "id": "0123456789abcdef0123456789abcdef"
    }
  ],
  "vars": {
    // Optional. Set a secret instead for production: npx wrangler secret put ACCESS_KEY
    // "ACCESS_KEY": ""
  },
  "observability": { "enabled": true }
}
